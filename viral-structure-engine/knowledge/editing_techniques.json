    "speed_ramp": {
      "name": "变速时间重映射",
      "hook": "useSpeedRamp",
      "file": "src/components/Effects.tsx",
      "description": "将线性帧映射到非线性进度，实现变速感知",
      "params": {
        "rampType": {
          "type": "enum", "default": "smooth",
          "values": [
            { "value": "slow_fast", "description": "开始慢→逐渐加速（抖音常见）" },
            { "value": "fast_slow", "description": "开始快→逐渐减速（子弹时间感）" },
            { "value": "beat_hit", "description": "节拍点前后加速，形成爆发感" },
            { "value": "smooth", "description": "缓入缓出匀速" }
          ]
        },
        "beatFrame": { "type": "number", "default": null, "description": "beat_hit模式下的节拍帧位置" }
      },
      "best_for": ["卡点变速", "高潮加速", "慢动作减速", "节奏变化"],
      "usage_note": "需要配音乐节拍使用；beat_hit模式需先检测BPM"
    },
    "motion_blur": {
      "name": "运动模糊",
      "component": "MotionBlur",
      "file": "src/components/Effects.tsx",
      "description": "方向性运动模糊，模拟快速移动拖影",
      "params": {
        "intensity": { "type": "number", "default": 0, "range": [0, 1], "description": "模糊强度" },
        "direction": { "type": "enum", "default": "horizontal", "values": ["horizontal", "vertical"] }
